# 훈련용 값으로 그림 범위 결정
imputer_2d = model_2d.named_steps["imputer"]
filled_train_2d = imputer_2d.transform(X_train_2d)

x_min = float(filled_train_2d[:, 0].min())
x_max = float(filled_train_2d[:, 0].max())
y_min = float(filled_train_2d[:, 1].min())
y_max = float(filled_train_2d[:, 1].max())

