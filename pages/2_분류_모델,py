st.header("5. 결정 트리의 질문 순서")

tree = question_model.named_steps["classifier"]
tree_structure = tree.tree_


def get_tree_questions(tree_model, feature_names):
    structure = tree_model.tree_
    questions = []

    def walk(node, depth, path):
        feature_index = structure.feature[node]

        if feature_index < 0:
            return

        feature = feature_names[feature_index]
        threshold = structure.threshold[node]

        questions.append(
            f"{len(questions) + 1}. "
            f"{'　' * depth}{' → '.join(path)}"
            f"{' → ' if path else ''}"
            f"{FEATURE_LABELS[feature]} ≤ {threshold:.3f} 인가?"
        )

        if depth < 2:
            walk(
                structure.children_left[node],
                depth + 1,
                path + [f"{FEATURE_LABELS[feature]} ≤ {threshold:.3f}"],
            )
            walk(
                structure.children_right[node],
                depth + 1,
                path + [f"{FEATURE_LABELS[feature]} > {threshold:.3f}"],
            )

    walk(0, 0, [])
    return questions


questions = get_tree_questions(
    tree,
    selected_features,
)

